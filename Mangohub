    closeBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
    closeBtn.TextSize = 18
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.Parent = titleBar

    local closeCorner = Instance.new("UICorner")
    closeCorner.CornerRadius = UDim.new(0, 8)
    closeCorner.Parent = closeBtn

    closeBtn.MouseButton1Click:Connect(function()
        uiVisible = false
        screenGui.Enabled = false
        print("🔴 UI Closed (click mango 🥭 to reopen)")
    end)

    -- ============================================
    -- BUTTONS
    -- ============================================

    local buttonWidth = 0.17
    local buttonHeight = 38
    local spacingX = 0.025
    local spacingY = 8
    local startX = 0.025
    local startY = 48

    local buttons = {}
    local textBox = nil
    local dropKickButton = nil
    local invicibleFlyButton = nil
    local infYieldButton = nil
    local ajaanHubButton = nil
    local mm2HubButton = nil
    local rblxCSGOButton = nil
    local monochromeButton = nil
    local novolineButton = nil

    local function createButton(text, xPos, yPos)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(buttonWidth, 0, 0, buttonHeight)
        btn.Position = UDim2.new(xPos, 0, 0, yPos)
        btn.BackgroundColor3 = Color3.fromRGB(255, 180, 80)
        btn.BackgroundTransparency = 0.45
        btn.Text = text
        btn.TextColor3 = Color3.fromRGB(0, 0, 0)
        btn.TextSize = 13
        btn.Font = Enum.Font.GothamBold
        btn.Parent = mainFrame

        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 8)
        btnCorner.Parent = btn

        btn.MouseEnter:Connect(function()
            btn.BackgroundTransparency = 0.25
            btn.BackgroundColor3 = Color3.fromRGB(255, 200, 100)
        end)
        btn.MouseLeave:Connect(function()
            btn.BackgroundTransparency = 0.45
            btn.BackgroundColor3 = Color3.fromRGB(255, 180, 80)
        end)

        return btn
    end

    -- ROW 1
    dropKickButton = createButton("DropKick", startX, startY)
    table.insert(buttons, dropKickButton)

    invicibleFlyButton = createButton("InvicibleFly", startX + (buttonWidth + spacingX), startY)
    table.insert(buttons, invicibleFlyButton)

    infYieldButton = createButton("InfYield", startX + (buttonWidth + spacingX) * 2, startY)
    table.insert(buttons, infYieldButton)

    ajaanHubButton = createButton("AjaanHub", startX + (buttonWidth + spacingX) * 3, startY)
    table.insert(buttons, ajaanHubButton)

    mm2HubButton = createButton("MM2HUB", startX + (buttonWidth + spacingX) * 4, startY)
    table.insert(buttons, mm2HubButton)

    -- ROW 2
    local row2Y = startY + buttonHeight + spacingY

    rblxCSGOButton = createButton("RblxCSGO", startX, row2Y)
    table.insert(buttons, rblxCSGOButton)

    textBox = Instance.new("TextBox")
    textBox.Size = UDim2.new(buttonWidth * 2 + spacingX, 0, 0, buttonHeight)
    textBox.Position = UDim2.new(startX + (buttonWidth + spacingX), 0, 0, row2Y)
    textBox.BackgroundColor3 = Color3.fromRGB(255, 200, 120)
    textBox.BackgroundTransparency = 0.55
    textBox.Text = ""
    textBox.TextColor3 = Color3.fromRGB(0, 0, 0)
    textBox.TextSize = 14
    textBox.Font = Enum.Font.Gotham
    textBox.PlaceholderText = "Enter text..."
    textBox.PlaceholderColor3 = Color3.fromRGB(80, 60, 30)
    textBox.ClearTextOnFocus = false
    textBox.Parent = mainFrame

    local textBoxCorner = Instance.new("UICorner")
    textBoxCorner.CornerRadius = UDim.new(0, 8)
    textBoxCorner.Parent = textBox

    textBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            textBox.Text = ""
            textBox.PlaceholderText = "Enter text..."
        end
    end)

    monochromeButton = createButton("Monochrome", startX + (buttonWidth + spacingX) * 3, row2Y)
    table.insert(buttons, monochromeButton)

    novolineButton = createButton("Novoline", startX + (buttonWidth + spacingX) * 4, row2Y)
    table.insert(buttons, novolineButton)

    -- ROW 3-5 (unchanged)
    for row = 2, 4 do
        for col = 0, 4 do
            local xPos = startX + col * (buttonWidth + spacingX)
            local yPos = startY + row * (buttonHeight + spacingY)
            local num = row * 5 + col + 1
            local btn = createButton("Btn " .. num, xPos, yPos)
            table.insert(buttons, btn)
        end
    end

    -- ============================================
    -- BUTTON CLICKS
    -- ============================================

    dropKickButton.MouseButton1Click:Connect(loadDropKick)
    invicibleFlyButton.MouseButton1Click:Connect(loadInvicibleFly)
    infYieldButton.MouseButton1Click:Connect(loadInfYield)
    ajaanHubButton.MouseButton1Click:Connect(loadAjaanHub)
    mm2HubButton.MouseButton1Click:Connect(loadMM2HUB)
    rblxCSGOButton.MouseButton1Click:Connect(loadRblxCSGO)
    monochromeButton.MouseButton1Click:Connect(loadMonochrome)
    novolineButton.MouseButton1Click:Connect(loadNovoline)

    for i, btn in ipairs(buttons) do
        if btn ~= dropKickButton and btn ~= invicibleFlyButton and btn ~= infYieldButton and btn ~= ajaanHubButton and btn ~= mm2HubButton and btn ~= rblxCSGOButton and btn ~= monochromeButton and btn ~= novolineButton then
            btn.MouseButton1Click:Connect(function()
                local text = textBox.Text or ""
                print("🔘 Button " .. i .. " clicked! | Text: " .. text)
            end)
        end
    end

    -- ============================================
    -- DRAGGABLE (Main UI)
    -- ============================================

    local function makeDraggable(frame)
        local drag = false
        local dragStart, startPos

        frame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                drag = true
                dragStart = input.Position
                startPos = mainFrame.Position
            end
        end)

        frame.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                drag = false
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement and drag then
                local delta = input.Position - dragStart
                mainFrame.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end)
    end

    makeDraggable(titleBar)

    return screenGui
end

