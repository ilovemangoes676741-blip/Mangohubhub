    title.Parent = titleBar

    local discordTag = Instance.new("TextButton")
    discordTag.Size = UDim2.new(0.35, 0, 1, 0)
    discordTag.Position = UDim2.new(0.40, 0, 0, 0)
    discordTag.BackgroundTransparency = 1
    discordTag.Text = "Discord/Doggywoof8thaccphone"
    discordTag.TextColor3 = Color3.fromRGB(0, 0, 0)
    discordTag.TextSize = 14
