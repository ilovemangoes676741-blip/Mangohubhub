-- ============================================
-- CREATE MANGO TOGGLE BUTTON (DRAGGABLE - TOP)
-- ============================================

local function createMangoToggle()
    local toggleGui = Instance.new("ScreenGui")
    toggleGui.Name = "MangoToggle"
    toggleGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    toggleGui.ResetOnSpawn = false
    toggleGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    local toggleFrame = Instance.new("Frame")
    toggleFrame.Size = UDim2.new(0, 50, 0, 50)
    toggleFrame.Position = UDim2.new(0.5, -25, 0, 10)
    toggleFrame.BackgroundColor3 = Color3.fromRGB(255, 170, 50)
    toggleFrame.BackgroundTransparency = 0.2
    toggleFrame.BorderSizePixel = 2
    toggleFrame.BorderColor3 = Color3.fromRGB(255, 190, 100)
    toggleFrame.Parent = toggleGui

    local toggleCorner = Instance.new("UICorner")
    toggleCorner.CornerRadius = UDim.new(0, 12)
    toggleCorner.Parent = toggleFrame

    local toggleButton = Instance.new("TextButton")
    toggleButton.Size = UDim2.new(1, 0, 1, 0)
    toggleButton.BackgroundTransparency = 1
    toggleButton.Text = "🥭"
    toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleButton.TextSize = 28
    toggleButton.Font = Enum.Font.GothamBold
    toggleButton.Parent = toggleFrame

    -- DRAG LOGIC (works on PC)
    local dragData = {
        dragging = false,
        startPos = nil,
        startMouse = nil,
        moved = false,
    }

    local function startDrag(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragData.startMouse = input.Position
            dragData.startPos = toggleFrame.Position
            dragData.moved = false
            dragData.dragging = true
        end
    end

    local function updateDrag(input)
        if dragData.dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragData.startMouse
            if delta.Magnitude > 5 then
                dragData.moved = true
            end
            if dragData.moved then
                toggleFrame.Position = UDim2.new(
                    dragData.startPos.X.Scale,
                    dragData.startPos.X.Offset + delta.X,
                    dragData.startPos.Y.Scale,
                    dragData.startPos.Y.Offset + delta.Y
                )
            end
        end
    end

    local function endDrag(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if dragData.dragging and not dragData.moved then
                if screenGui then
                    uiVisible = not uiVisible
                    screenGui.Enabled = uiVisible
                    print(uiVisible and "🟢 UI Shown" or "🔴 UI Hidden")
                end
            end
            dragData.dragging = false
            dragData.moved = false
        end
    end

    toggleButton.InputBegan:Connect(startDrag)
    UserInputService.InputChanged:Connect(updateDrag)
    UserInputService.InputEnded:Connect(endDrag)
    toggleFrame.InputBegan:Connect(startDrag)

    return toggleGui
end

